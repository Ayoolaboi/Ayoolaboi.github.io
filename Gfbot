
#property version "1.00"
#property description "EMA 50/200 crossover with RSI confirmation"

#include <Trade/Trade.mqh>
CTrade trade;

input double Lots = 0.01;
input int StopLossPoints = 200;
input int TakeProfitPoints = 300;
input int FastEMA = 50;
input int SlowEMA = 200;
input int RSIPeriod = 14;
input double BuyRSI = 50.0;
input double SellRSI = 50.0;
input ulong MagicNumber = 502001;

int fastHandle, slowHandle, rsiHandle;
datetime lastBar = 0;

int OnInit()
{
   fastHandle = iMA(_Symbol, PERIOD_M1, FastEMA, 0,
                    MODE_EMA, PRICE_CLOSE);
   slowHandle = iMA(_Symbol, PERIOD_M1, SlowEMA, 0,
                    MODE_EMA, PRICE_CLOSE);
   rsiHandle = iRSI(_Symbol, PERIOD_M1, RSIPeriod,
                    PRICE_CLOSE);

   if(fastHandle == INVALID_HANDLE ||
      slowHandle == INVALID_HANDLE ||
      rsiHandle == INVALID_HANDLE)
      return INIT_FAILED;

   trade.SetExpertMagicNumber(MagicNumber);
   trade.SetTypeFillingBySymbol(_Symbol);
   return INIT_SUCCEEDED;
}

void OnDeinit(const int reason)
{
   IndicatorRelease(fastHandle);
   IndicatorRelease(slowHandle);
   IndicatorRelease(rsiHandle);
}

void OnTick()
{
   if(_Period != PERIOD_M1)
      return;

   datetime barTime = iTime(_Symbol, PERIOD_M1, 0);
   if(barTime == 0 || barTime == lastBar)
      return;
   lastBar = barTime;

   if(PositionSelect(_Symbol))
      return;

   double fast1[], fast2[], slow1[], slow2[], rsi1[];
   ArraySetAsSeries(fast1, true);
   ArraySetAsSeries(fast2, true);
   ArraySetAsSeries(slow1, true);
   ArraySetAsSeries(slow2, true);
   ArraySetAsSeries(rsi1, true);

   if(CopyBuffer(fastHandle, 0, 1, 1, fast1) != 1 ||
      CopyBuffer(fastHandle, 0, 2, 1, fast2) != 1 ||
      CopyBuffer(slowHandle, 0, 1, 1, slow1) != 1 ||
      CopyBuffer(slowHandle, 0, 2, 1, slow2) != 1 ||
      CopyBuffer(rsiHandle, 0, 1, 1, rsi1) != 1)
      return;

   bool buy = fast2[0] <= slow2[0] &&
              fast1[0] > slow1[0] &&
              rsi1[0] > BuyRSI;

   bool sell = fast2[0] >= slow2[0] &&
               fast1[0] < slow1[0] &&
               rsi1[0] < SellRSI;

   MqlTick tick;
   if(!SymbolInfoTick(_Symbol, tick))
      return;

   double point = SymbolInfoDouble(_Symbol, SYMBOL_POINT);
   int digits = (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS);

   if(buy)
   {
      double sl = NormalizeDouble(
         tick.ask - StopLossPoints * point, digits);
      double tp = NormalizeDouble(
         tick.ask + TakeProfitPoints * point, digits);

      trade.Buy(Lots, _Symbol, 0, sl, tp, "EMA RSI BUY");
   }
   else if(sell)
   {
      double sl = NormalizeDouble(
         tick.bid + StopLossPoints * point, digits);
      double tp = NormalizeDouble(
         tick.bid - TakeProfitPoints * point, digits);

      trade.Sell(Lots, _Symbol, 0, sl, tp, "EMA RSI SELL");
   }
}
